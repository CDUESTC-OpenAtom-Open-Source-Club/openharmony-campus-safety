<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:name=".MyApplication" android:allowBackup="false"
        android:label="鸿蒙智安" android:icon="@drawable/arkuix"
        android:extractNativeLibs="true" android:supportsRtl="true"
        android:usesCleartextTraffic="true" android:theme="@android:style/Theme.Light.NoTitleBar">
        <activity android:name=".EntryEntryAbilityActivity" android:exported="true"
            android:configChanges="orientation|keyboard|keyboardHidden|layoutDirection|screenSize|uiMode|smallestScreenSize|density"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
